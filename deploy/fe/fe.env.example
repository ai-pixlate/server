# /etc/pixlate/fe.env — FE 컨테이너 설정. 비밀 값은 PIXLATE_INTERNAL_RENDER_TOKEN 하나뿐이다 → 이 파일은 root 600 으로 둔다.
# FE_IMAGE 는 digest 로만 지정한다(태그 금지). 이미지는 로컬·CI 에서 빌드해 ECR 에 올린 것을 쓴다.
FE_IMAGE=<ACCOUNT>.dkr.ecr.<REGION>.amazonaws.com/pixlate-fe@sha256:<64자리>
# ALB 대상 그룹이 보는 호스트 포트
FE_PORT=3000
# 컨테이너 메모리 상한. 2026-10-13 로컬 실측 최대 143MiB(유휴·페이지·API 프록시). 업로드 경로 확정 뒤 다시 정한다
FE_MEM_LIMIT=384m
# [비밀] 서버 렌더 전용 내부 경로(/internal/typeset-render) 토큰 — pixlate.env 와 같은 값. 비우면 내부 경로는 항상 404(서버 렌더 실패).
# 숨김 입력으로만 넣는다(채팅 · 기록 · 로그 금지).
PIXLATE_INTERNAL_RENDER_TOKEN=
