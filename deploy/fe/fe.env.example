# /etc/pixlate/fe.env — FE 컨테이너 설정. 비밀 값 없음(이미지 주소·포트·메모리 상한만).
# FE_IMAGE 는 digest 로만 지정한다(태그 금지). 이미지는 로컬·CI 에서 빌드해 ECR 에 올린 것을 쓴다.
FE_IMAGE=<ACCOUNT>.dkr.ecr.<REGION>.amazonaws.com/pixlate-fe@sha256:<64자리>
# ALB 대상 그룹이 보는 호스트 포트
FE_PORT=3000
# 컨테이너 메모리 상한. 2026-10-13 로컬 실측 최대 143MiB(유휴·페이지·API 프록시). 업로드 경로 확정 뒤 다시 정한다
FE_MEM_LIMIT=384m
