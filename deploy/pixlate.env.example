# EC2 설치 위치: /etc/pixlate/pixlate.env (root 소유, chmod 600)
# 이 파일은 키 목록만 담은 템플릿이다. 실제 값은 팀 공유 문서에서 받아 서버에만 둔다.

# RDS PostgreSQL 16
DATABASE_URL=postgresql+psycopg://<DB사용자>:<RDS비번>@<RDS엔드포인트>:5432/<DB이름>

# 액세스 토큰 서명 키
JWT_SECRET=<임의의 긴 문자열>

# S3 (인증은 EC2 IAM 역할)
S3_BUCKET=<버킷 이름>
AWS_REGION=ap-northeast-2

# Redis: start-pixlate.sh 가 requirepass 로 쓰고, 워커·API 는 아래 URL 로 접속한다.
# EC2 안의 컨테이너끼리는 docker 이름 pixlate-redis 로 붙는다.
REDIS_PASSWORD=<Redis비번>
CELERY_BROKER_URL=redis://:<Redis비번>@pixlate-redis:6379/0
CELERY_RESULT_BACKEND=redis://:<Redis비번>@pixlate-redis:6379/1

# 선택(코드 기본값이 있음)
# CELERY_VISIBILITY_TIMEOUT=3600   # GPU 워커와 같은 값
# JWT_TTL=86400
# S3_PRESIGN_TTL=300
# FRONTEND_ORIGINS=*

# AI 파이프라인 연결(선택 · 개발 기본값은 운영 수치가 아니다)
# GEMINI_API_KEY=<결제 연결 유료 등급 키 — D9-4. 값은 서버에만>
# PIXLATE_ANALYZE_USE_LLM=1          # ③ llm_assist 사용(0 이면 휴리스틱만)
# PIXLATE_PIPELINE_CONFIG=            # 파이프라인 설정 파일(기본 pipeline/config/default.toml)
# PIXLATE_STYLE_DEFAULTS=             # 승인된 역할별 스타일 기본값 JSON. 없으면 측정 NULL·⑦ 실패 블록은 조판하지 않는다
# PIXLATE_CONTENT_TYPES=              # content_type 허용 목록(쉼표). 확정 전에는 비워 둔다(D7)
# PIXLATE_POLICY_RULES=               # ③-1′ 정책 규칙 JSON 경로(AI 제공). 없으면 ③-1·⑧ 은 AI_ADAPTER_UNAVAILABLE 실패
# PIXLATE_LEASE_TTL_S=120             # 실행 권한 TTL(초)
# PIXLATE_DISPATCH_STALE_S=300        # 대기 시도 재전달 기준(초)
# PIXLATE_UPLOAD_URL_TTL_S=300        # GPU 업로드 presigned URL 수명(초)
# PIXLATE_PURGE_WINDOW_H=24           # 전체 취소 후 S3 재삭제 감시 기간(시간)
