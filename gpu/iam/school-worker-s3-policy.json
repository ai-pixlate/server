{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInputsAndArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::<BUCKET>/source/*",
        "arn:aws:s3:::<BUCKET>/staging/*",
        "arn:aws:s3:::<BUCKET>/verified/*"
      ]
    },
    {
      "Sid": "WriteStagingAndVerified",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::<BUCKET>/staging/*",
        "arn:aws:s3:::<BUCKET>/verified/*"
      ]
    },
    {
      "Sid": "ListOnlyWorkerPrefixesForChecks",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::<BUCKET>",
      "Condition": {"StringLike": {"s3:prefix": ["source/*", "staging/*", "verified/*"]}}
    },
    {
      "Sid": "BucketRegionForChecks",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::<BUCKET>"
    }
  ]
}
